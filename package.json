{
  "name": "provenexit",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/shared",
    "enclave",
    "client",
    "mcp",
    "e2e"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "test": "npm test -w packages/shared -w client -w enclave -w mcp --if-present",
    "test:contract": "cd contracts/near && cargo test",
    "e2e": "npm test -w e2e",
    "build:status": "tsc -b && node scripts/build-status.mjs",
    "build:mcp": "tsc -b && node mcp/build.mjs",
    "build:npm": "npm run build:mcp && node scripts/build-npm.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vitest": "^4.0.0"
  }
}
